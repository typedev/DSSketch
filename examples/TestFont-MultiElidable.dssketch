family TestFont

axes
    CONTRAST CNTR 0:0:100
        NoContrast > 0 @elidable
        HighContrast > 100
    wdth Normal:Normal:Extended
        Normal > 100 @elidable
        Extended > 150
    wght Regular:Regular:Bold
        Regular > 400 @elidable
        Bold > 700

sources [CONTRAST, wdth, wght]
    NoContrast-Normal-Regular [NoContrast, Normal, Regular] @base
    HighContrast-Extended-Bold [HighContrast, Extended, Bold]

instances auto
    skip
        # Test combined elidable cleanup
        # All three are marked @elidable: NoContrast, Normal, Regular
        # The weight axis is excluded from elidable removal, so a weight label
        # such as "Regular" is always kept — font compilers expect it in styleName

        # "NoContrast Normal Regular" → "Regular" (NoContrast, Normal elided)
        Regular

        # "NoContrast Normal Bold" → "Bold" (NoContrast, Normal elided)
        Bold

        # "HighContrast Normal Regular" → "HighContrast Regular" (Normal elided)
        HighContrast Regular

        # "NoContrast Extended Regular" → "Extended Regular" (NoContrast elided)
        Extended Regular
