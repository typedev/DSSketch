<?xml version='1.0' encoding='UTF-8'?>
<designspace format="5.0">
  <axes>
    <axis tag="wght" name="weight" minimum="100" maximum="900" default="400">
      <map input="100" output="100"/>
      <map input="400" output="400"/>
      <map input="900" output="900"/>
      <labels>
        <label uservalue="400" name="Regular" elidable="true"/>
        <label uservalue="900" name="Bold"/>
      </labels>
    </axis>
  </axes>
  <sources>
    <source filename="Regular.ufo" name="master.regular" familyname="Probe" stylename="Regular">
      <lib copy="1"/>
      <groups copy="1"/>
      <features copy="1"/>
      <info copy="1"/>
      <location>
        <dimension name="weight" xvalue="400"/>
      </location>
    </source>
    <source filename="Bold.ufo" name="master.bold.correction" familyname="Probe Special" stylename="Bold Correction">
      <familyname xml:lang="fr">Probe Spécial</familyname>
      <info mute="1"/>
      <kerning mute="1"/>
      <glyph name="A" mute="1"/>
      <glyph name="Z" mute="1"/>
      <location>
        <dimension name="weight" xvalue="900"/>
      </location>
    </source>
  </sources>
</designspace>
