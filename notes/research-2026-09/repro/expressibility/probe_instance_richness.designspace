<?xml version='1.0' encoding='UTF-8'?>
<designspace format="5.0">
  <axes>
    <axis tag="wght" name="weight" minimum="100" maximum="900" default="400">
      <map input="100" output="100"/>
      <map input="400" output="400"/>
      <map input="900" output="900"/>
      <labels>
        <label uservalue="400" name="Regular" elidable="true"/>
        <label uservalue="900" name="Bold"/>
      </labels>
    </axis>
  </axes>
  <labels>
    <label name="Reading">
      <location>
        <dimension name="weight" uservalue="400"/>
      </location>
    </label>
  </labels>
  <sources>
    <source filename="Regular.ufo" familyname="Probe" stylename="Regular">
      <info copy="1"/>
      <location>
        <dimension name="weight" xvalue="400"/>
      </location>
    </source>
    <source filename="Bold.ufo" familyname="Probe" stylename="Bold">
      <location>
        <dimension name="weight" xvalue="900"/>
      </location>
    </source>
  </sources>
  <instances>
    <instance familyname="Probe" stylename="Regular" postscriptfontname="Probe-Regular" stylemapfamilyname="Probe" stylemapstylename="regular">
      <stylename xml:lang="fr">Normal</stylename>
      <familyname xml:lang="fr">Sonde</familyname>
      <location>
        <dimension name="weight" uservalue="400"/>
      </location>
      <lib>
        <dict>
          <key>com.example.note</key>
          <string>hello</string>
        </dict>
      </lib>
    </instance>
    <instance name="reading-instance" location="Reading" familyname="Probe" stylename="Reading Style"/>
  </instances>
</designspace>
