<?xml version='1.0' encoding='UTF-8'?>
<designspace format="5.0">
  <axes>
    <axis tag="wght" name="weight" minimum="100" maximum="900" default="400">
      <labelname xml:lang="en">weight</labelname>
      <map input="100" output="100"/>
      <map input="400" output="400"/>
      <map input="900" output="900"/>
      <labels ordering="0">
        <label uservalue="400" name="Regular" elidable="true"/>
        <label uservalue="900" name="Bold"/>
      </labels>
    </axis>
  </axes>
  <sources>
    <source filename="Regular.ufo" name="source.1" familyname="Probe" stylename="Regular">
      <lib copy="1"/>
      <groups copy="1"/>
      <features copy="1"/>
      <info copy="1"/>
      <location>
        <dimension name="weight" xvalue="400"/>
      </location>
    </source>
    <source filename="Bold.ufo" name="source.2" familyname="Probe" stylename="Bold">
      <location>
        <dimension name="weight" xvalue="900"/>
      </location>
    </source>
  </sources>
  <instances>
    <instance familyname="Probe" stylename="Regular" filename="instances/Probe-Regular.ufo" postscriptfontname="Probe-Regular">
      <location>
        <dimension name="weight" xvalue="400"/>
      </location>
    </instance>
    <instance familyname="Probe" stylename="Bold" filename="instances/Probe-Bold.ufo" postscriptfontname="Probe-Bold">
      <location>
        <dimension name="weight" xvalue="900"/>
      </location>
    </instance>
  </instances>
</designspace>
